# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env

# SECURITY WARNING: generate a fresh key for any real/shared deployment.
SECRET_KEY=change-me

# Set to False in production.
DEBUG=True

# Comma-separated list of allowed hosts. "*" allows all (dev only).
ALLOWED_HOSTS=*

# Which environment this is: "dev" (SQLite) or "prod" (PostgreSQL).
# Defaults to dev if unset.
ENVIRONMENT=dev

# --- dev: SQLite database file, relative to the backend/ directory. ---
DATABASE_PATH=data/db.sqlite3

# --- prod: PostgreSQL connection details. ---
POSTGRES_DB=syed_logistics_db
POSTGRES_USER=syed_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
